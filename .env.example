# Optional JSearch provider
RAPIDAPI_KEY=

# Optional Gemini model calls (takes precedence if both provider keys are set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI model calls
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional SMTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
